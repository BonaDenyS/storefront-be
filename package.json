{
  "name": "storefront-backend",
  "version": "1.0.0",
  "description": "Storefront Backend API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "watch": "tsc-watch --onSuccess \"node ./dist/server.js\"",
    "build": "tsc",
    "test": "cross-env ENV=test db-migrate --env test up && tsc && cross-env ENV=test jasmine --config=jasmine.json",
    "migrate:up": "db-migrate up",
    "migrate:down": "db-migrate down",
    "migrate:reset": "db-migrate reset"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "^4.3.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^18.15.11",
    "@types/pg": "^8.6.6",
    "@types/supertest": "^2.0.12",
    "cross-env": "^10.1.0",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.2.2",
    "jasmine": "^4.6.0",
    "jasmine-ts": "^0.4.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.0.4"
  }
}
